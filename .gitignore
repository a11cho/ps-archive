# Ignore everything by default, including executables without extensions.
*

# Traverse directories so source files can be found at any depth.
!*/

# Track this configuration and C/C++ source/header files only.
!/.gitignore

# C
!*.[cChH]

# C++
!*.cpp
!*.hpp
!*.cc
!*.cxx
!*.hh
!*.hxx

# Exclude build output and editor/cache directories.
build/
bin/
obj/
out/
.vs/
.vscode/
.idea/
.cache/